// Prisma Schema for PropTelangana Platform
// Configured with SQLite for local dev & PostgreSQL schema for production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  phone        String?
  role         String       @default("USER") // SUPER_ADMIN, ADMIN, EDITOR, AGENT, USER
  avatar       String?
  status       String       @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  
  agent        Agent?
  favorites    Favorite[]
  comparisons  Comparison[]
  auditLogs    AuditLog[]
  notifications Notification[]
  blogPosts    BlogPost[]

  @@index([email])
  @@index([role])
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  permissions Permission[]
  createdAt   DateTime     @default(now())
}

model Permission {
  id        String   @id @default(uuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  action    String   // e.g. "CREATE", "READ", "UPDATE", "DELETE"
  subject   String   // e.g. "PROPERTY", "PROJECT", "LEAD", "USER"
  createdAt DateTime @default(now())
}

model Developer {
  id              String     @id @default(uuid())
  name            String
  slug            String     @unique
  logo            String?
  coverImage      String?
  description     String?
  website         String?
  phone           String?
  email           String?
  officeAddress   String?
  experienceYears Int?       @default(0)
  verified        Boolean    @default(false)
  reraRegistered  Boolean    @default(true)
  socialLinks     String?    // JSON string
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  properties      Property[]
  projects        Project[]

  @@index([slug])
}

model Location {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  type        String     @default("LOCALITY") // STATE, DISTRICT, CITY, LOCALITY
  parentId    String?
  parent      Location?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children    Location[] @relation("LocationHierarchy")
  description String?
  coverImage  String?
  avgPriceSqft Float?
  popular     Boolean    @default(false)
  latitude    Float?
  longitude   Float?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  properties  Property[]
  projects    Project[]

  @@index([slug])
  @@index([type])
}

model Amenity {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  icon        String?
  category    String            @default("CONVENIENCE") // SAFETY, LEISURE, SPORTS, CONVENIENCE, ECO
  createdAt   DateTime          @default(now())
  properties  PropertyAmenity[]
}

model Property {
  id                 String            @id @default(uuid())
  propertyId         String            @unique // Display ID e.g. "PT-PROP-1001"
  title              String
  slug               String            @unique
  description        String
  propertyType       String            // APARTMENT, VILLA, PLOT, COMMERCIAL, LAND, INDEPENDENT_HOUSE
  listingType        String            @default("BUY") // BUY, RENT
  price              Float
  minPrice           Float?
  maxPrice           Float?
  priceDisplay       String?           // e.g. "₹ 1.85 Cr"
  area               Float
  areaUnit           String            @default("sqft") // sqft, sqyd, acres
  bedrooms           Int?
  bathrooms          Int?
  balconies          Int?
  floor              Int?
  totalFloors        Int?
  facing             String?           // East, West, North, South, North-East, etc.
  furnishing         String?           @default("UNFURNISHED") // UNFURNISHED, SEMI_FURNISHED, FULLY_FURNISHED
  possessionStatus   String            @default("READY_TO_MOVE") // READY_TO_MOVE, UNDER_CONSTRUCTION, RESALE, NEW_LAUNCH
  constructionStatus String?
  reraNumber         String?
  approvalInfo       String?           // HMDA, DTCP, GHMC, RERA Approved
  address            String
  locality           String
  city               String            @default("Hyderabad")
  district           String            @default("Hyderabad")
  state              String            @default("Telangana")
  pincode            String?
  latitude           Float?
  longitude          Float?
  
  developerId        String?
  developer          Developer?        @relation(fields: [developerId], references: [id])
  agentId            String?
  agent              Agent?            @relation(fields: [agentId], references: [id])
  projectId          String?
  project            Project?          @relation(fields: [projectId], references: [id])
  locationId         String?
  locationRef        Location?         @relation(fields: [locationId], references: [id])

  status             String            @default("PUBLISHED") // DRAFT, PENDING_REVIEW, PUBLISHED, FEATURED, SOLD, RENTED, ARCHIVED
  featured           Boolean           @default(false)
  viewsCount         Int               @default(0)
  publishedAt        DateTime?         @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  images             PropertyImage[]
  videos             PropertyVideo[]
  documents          PropertyDocument[]
  amenities          PropertyAmenity[]
  leads              Lead[]
  favorites          Favorite[]
  comparisons        Comparison[]

  @@index([slug])
  @@index([city])
  @@index([locality])
  @@index([propertyType])
  @@index([listingType])
  @@index([price])
  @@index([status])
  @@index([featured])
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  altText    String?
  isCover    Boolean  @default(false)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

model PropertyVideo {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  title      String?
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

model PropertyDocument {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  fileUrl    String
  fileType   String?  // brochure, floorplan, rera, approval
  fileSize   String?
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

model PropertyAmenity {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenityId  String
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
}

model Project {
  id               String            @id @default(uuid())
  projectId        String            @unique // e.g. "PT-PRJ-2001"
  name             String
  slug             String            @unique
  description      String
  developerId      String?
  developer        Developer?        @relation(fields: [developerId], references: [id])
  location         String
  city             String            @default("Hyderabad")
  district         String            @default("Hyderabad")
  projectType      String            // LUXURY_APARTMENTS, GATED_COMMUNITY_VILLAS, PLOTTED_DEVELOPMENT, COMMERCIAL_COMPLEX
  totalArea        String?           // e.g. "25 Acres"
  totalUnits       String?           // e.g. "450 Units"
  plotSizes        String?           // e.g. "200 - 500 Sq.Yds"
  villaSizes       String?           // e.g. "3500 - 6500 Sq.Ft"
  apartmentSizes   String?           // e.g. "2, 3 & 4 BHK (1450 - 3800 Sq.Ft)"
  minPrice         Float?
  maxPrice         Float?
  priceRange       String?           // e.g. "₹ 1.25 Cr - ₹ 4.50 Cr"
  possessionDate   String?           // e.g. "December 2026"
  reraNumber       String?
  approvalDetails  String?           // HMDA & RERA Approved
  amenitiesList    String?           // Comma separated or JSON string
  connectivity     String?           // Bullet points / JSON string
  brochureUrl      String?
  latitude         Float?
  longitude        Float?
  contactPhone     String?
  contactEmail     String?
  status           String            @default("ONGOING") // UPCOMING, ONGOING, READY_TO_MOVE, COMPLETED
  featured         Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  images           ProjectImage[]
  videos           ProjectVideo[]
  documents        ProjectDocument[]
  properties       Property[]
  leads            Lead[]
  favorites        Favorite[]
  locationRefId    String?
  locationRef      Location?         @relation(fields: [locationRefId], references: [id])

  @@index([slug])
  @@index([city])
  @@index([status])
}

model ProjectImage {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url        String
  altText    String?
  isCover    Boolean  @default(false)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([projectId])
}

model ProjectVideo {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  title     String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

model ProjectDocument {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  fileUrl   String
  fileType  String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Agent {
  id           String     @id @default(uuid())
  userId       String?    @unique
  user         User?      @relation(fields: [userId], references: [id])
  employeeId   String     @unique
  name         String
  email        String     @unique
  phone        String
  designation  String     @default("Senior Property Consultant")
  photo        String?
  bio          String?
  reraNumber   String?
  status       String     @default("ACTIVE")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  properties   Property[]
  leads        Lead[]

  @@index([employeeId])
}

model Lead {
  id             String              @id @default(uuid())
  leadId         String              @unique // e.g. "PT-LD-1001"
  name           String
  phone          String
  email          String?
  propertyId     String?
  property       Property?           @relation(fields: [propertyId], references: [id])
  projectId      String?
  project        Project?            @relation(fields: [projectId], references: [id])
  message        String?
  source         String              @default("WEBSITE")
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  pageUrl        String?
  assignedAgentId String?
  assignedAgent  Agent?              @relation(fields: [assignedAgentId], references: [id])
  status         String              @default("NEW") // NEW, CONTACTED, INTERESTED, SITE_VISIT, NEGOTIATION, CONVERTED, LOST, CLOSED
  priority       String              @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  nextFollowUp   DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  notes          LeadNote[]
  statusHistory  LeadStatusHistory[]

  @@index([leadId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model LeadNote {
  id         String   @id @default(uuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String   @default("Admin")
  note       String
  createdAt  DateTime @default(now())

  @@index([leadId])
}

model LeadStatusHistory {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  oldStatus   String?
  newStatus   String
  changedById String?
  remarks     String?
  createdAt   DateTime @default(now())

  @@index([leadId])
}

model Favorite {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
}

model Comparison {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String?
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
}

model BlogPost {
  id            String        @id @default(uuid())
  title         String
  slug          String        @unique
  featuredImage String?
  content       String
  excerpt       String?
  categoryId    String?
  category      BlogCategory? @relation(fields: [categoryId], references: [id])
  authorId      String?
  author        User?         @relation(fields: [authorId], references: [id])
  authorName    String        @default("PropTelangana Editorial")
  tags          String?       // comma separated
  seoTitle      String?
  metaDescription String?
  status        String        @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  viewsCount    Int           @default(0)
  publishedAt   DateTime?     @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([slug])
  @@index([status])
}

model BlogCategory {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  posts       BlogPost[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("LEAD") // LEAD, PROPERTY, SYSTEM
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model SiteSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userEmail String?
  action    String   // CREATE, UPDATE, DELETE, PUBLISH, UNPUBLISH, ASSIGN
  entity    String   // PROPERTY, PROJECT, LEAD, DEVELOPER, USER, BLOG
  entityId  String
  metadata  String?  // JSON string
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([createdAt])
}
