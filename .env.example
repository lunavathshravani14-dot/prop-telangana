# ==========================================
# PROP TELANGANA PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
# In production: https://proptelangana.com
NEXT_PUBLIC_SITE_NAME="PropTelangana"

# PostgreSQL Database Connection
# Example local or cloud PostgreSQL (Neon, Supabase, Railway, AWS RDS):
# postgresql://postgres:password@localhost:5432/proptelangana?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/proptelangana?schema=public"

# Authentication & Security
AUTH_SECRET="super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Cloud Object Storage (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_PROVIDER="local" # 'local' or 's3'
STORAGE_ENDPOINT=""
STORAGE_BUCKET="proptelangana-media"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="ap-south-1"
NEXT_PUBLIC_STORAGE_PUBLIC_URL=""

# Email Notifications (SMTP)
EMAIL_SERVER="smtp.sendgrid.net"
EMAIL_PORT="587"
EMAIL_USER="apikey"
EMAIL_PASSWORD=""
EMAIL_FROM="notifications@proptelangana.com"

# External Integrations
MAP_API_KEY="YOUR_GOOGLE_MAPS_OR_MAPBOX_KEY"
ANALYTICS_ID="G-XXXXXXXXXX"
WHATSAPP_SUPPORT_NUMBER="917013873126"
SUPPORT_PHONE="+91 70138 73126"
SUPPORT_EMAIL="jbinfra.sales25@gmail.com"
